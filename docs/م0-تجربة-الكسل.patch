@@ -229,6 +229,10 @@
 export function begin(id,arg){
  const d=(id&&typeof id==="object")?id:findTool(id);
  if(!d){H.rep("wr",`أداة غير معروفة: ${id}`);return false}
+ if(d.lazy){            /* تجربة م٠: عقبٌ كسول — يُحمَّل ثم يُبدأ الحقيقيّ (غير متزامن) */
+  d.lazy().then(()=>{const r=findTool(d.id); if(r&&!r.lazy)begin(r,arg)}).catch(e=>H.rep("er",e.message));
+  return true;
+ }
  if(T.def)cancel(true);
  T.def=d; T.id=d.id;
  T.steps=(d.steps||[]).slice();
diff -ruN -x node_modules proj/src/ui/lazy-civil.js proj-trial/src/ui/lazy-civil.js
--- proj/src/ui/lazy-civil.js	1970-01-01 00:00:00.000000000 +0000
+++ proj-trial/src/ui/lazy-civil.js	2026-10-30 00:42:47.520758439 +0000
@@ -0,0 +1,31 @@
+/* ═══ تجربة م٠ ب٠-٣ ═══ عقبُ الأدوات الكسولة (مولَّد) — لا يُشحن */
+import {defTool,TOOLS} from "../tools/registry.js";
+const L=(d,f)=>{if(!TOOLS[d.id]||TOOLS[d.id].lazy)defTool(Object.assign(d,{lazy:f}))};
+const roof=()=>import("../tools/roof.js");
+L({"id":"roof","alias":"rf سقف","label":"سقف","hint":"نقاط الحلقة · Enter أو C يُغلق · Esc يلغي · U يتراجع"},roof);
+const boqreport=()=>import("../tools/boqreport.js");
+L({"id":"report","alias":"report تقرير","label":"تقرير العميل","hint":"يولّد تقرير HTML وجدول فتحات CSV ويُنزّلهما — قراءةٌ لا تعديل"},boqreport);
+const elev=()=>import("../tools/elev.js");
+L({"id":"elev","alias":"واجهة الواجهة elevation","label":"واجهة","hint":"يفرد الجدران الخارجية المواجهة · ELEV S أو ELEV 315 — ولا تتحدّث تلقائياً بعدها"},elev);
+const section=()=>import("../tools/section.js");
+L({"id":"section","alias":"مقطع قطاع sect","label":"مقطع","hint":"نقطتان لخطّ القطع · يُقطَع ما يعبره الخطّ بنطاقه — ولا يتحدّث تلقائياً بعدها"},section);
+const sheet=()=>import("../tools/sheet.js");
+L({"id":"vport","alias":"vp منفذ منفذ_ورقه","label":"منفذ ورقة","hint":"ركنا المستطيل في النموذج — يُسقَط على الورقة بمقياس المنفذ","ico":"sheet"},sheet);
+L({"id":"detail","alias":"dc detail تفصيله وسم","label":"وسم تفصيلة","hint":"معرّف منفذ المصدر · معرّف الهدف · موضع الرمز على النموذج"},sheet);
+L({"id":"addsheet","alias":"shnew ورقه_جديده اضف_ورقه","label":"ورقة جديدة","hint":"تُضاف ورقةٌ بالمقاس الافتراضي وتصير الجارية","ico":"sheet"},sheet);
+L({"id":"renamesheet","alias":"shren سم_الورقه اعد_تسميه","label":"إعادة تسمية الورقة","hint":"الاسمُ الجديد للورقة الجارية — يقبل وسيطاً بعد الأمر","ico":"sheet"},sheet);
+L({"id":"delsheet","alias":"shdel احذف_ورقه","label":"حذف ورقة","hint":"تُحذَف الورقةُ الجارية بمنافذها — ولا تُحذَف الأخيرة","ico":"del"},sheet);
+L({"id":"nextsheet","alias":"shnext الورقه_التاليه","label":"الورقة التالية","hint":"تنقّلٌ دوريٌّ إلى الورقة التالية","ico":"redo"},sheet);
+L({"id":"prevsheet","alias":"shprev الورقه_السابقه","label":"الورقة السابقة","hint":"تنقّلٌ دوريٌّ إلى الورقة السابقة","ico":"undo"},sheet);
+L({"id":"vpclip","alias":"vpc قص_المنفذ حد_المنفذ","label":"قص المنفذ","hint":"انقر خطّاً متعدّداً مغلقاً ليكون حدَّ المنفذ · «انزع» يُعيده مستطيلاً","ico":"sheet"},sheet);
+const clouds=()=>import("../tools/clouds.js");
+L({"id":"cloud","alias":"rcl cloud سحابه مراجعه غيمه","label":"سحابة مراجعة","hint":"نقاط الحلقة · C أو Enter يغلق · نصف قطر الفَلَقة في الخيارات"},clouds);
+L({"id":"cloude","alias":"rcle سحابه_التحديد","label":"سحابة حول التحديد","hint":"حدّد عناصر مغلقة ثم شغّل الأمر · نصف القطر: rcle r=0.3"},clouds);
+const macros=()=>import("../tools/macros.js");
+L({"id":"macrorec","alias":"rec سجل_ماكرو تسجيل_ماكرو","label":"تسجيل ماكرو","hint":"يبدأ تسجيل أوامرك · مرّةً ثانية يوقفه ويحفظه"},macros);
+L({"id":"macroplay","alias":"play شغل_ماكرو ماكرو","label":"تشغيل ماكرو","hint":"play <اسم> — خطوة تراجعٍ واحدة، وأيّ فشلٍ يُرجِع الكلّ"},macros);
+L({"id":"macrodel","alias":"delmacro احذف_ماكرو","label":"حذف ماكرو","hint":"delmacro <اسم>"},macros);
+L({"id":"macrolist","alias":"macros ماكروهات","label":"قائمة الماكروهات","hint":"يعرض الماكروهات المحفوظة"},macros);
+/* تحميلٌ مسبق في الخمول: الأداةُ جاهزةٌ غالباً قبل أوّل نقرة */
+const idle=globalThis.requestIdleCallback||(f=>setTimeout(f,3000));
+idle(()=>{[roof,boqreport,elev,section,sheet,clouds,macros].forEach(f=>f().catch(()=>{}))});
